[PHP]
engine = On
short_open_tag = Off
expose_php = Off
max_execution_time = 600
max_input_time = 600
memory_limit = 256M
post_max_size = 64M
upload_max_filesize = 64M
max_file_uploads = 20

display_errors = On
display_startup_errors = On
error_reporting = E_ALL
log_errors = On
error_log = {{APP_SUPPORT}}/logs/php-error.log
date.timezone = {{TIMEZONE}}

[MySQLi]
mysqli.default_socket = {{APP_SUPPORT}}/run/mysql.sock

[Pdo_mysql]
pdo_mysql.default_socket = {{APP_SUPPORT}}/run/mysql.sock

[opcache]
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 32
opcache.interned_strings_buffer = 8
opcache.max_accelerated_files = 4000
opcache.revalidate_freq = 0
opcache.validate_timestamps = 1

